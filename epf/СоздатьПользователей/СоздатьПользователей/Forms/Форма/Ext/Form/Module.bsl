#Область ОбработчикиСобытийФормы

&НаКлиенте
Перем ПутьКОбработке; // каталог обработки

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	УбратьПодтверждениеПриЗавершенииПрограммы();
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	СтрокаЗапуска = СокрЛП(ПараметрЗапуска);

	Если СтрокаЗапуска = "" Тогда
		Возврат;
	КонецЕсли;

	ПутьФайлаРезультата = "";
	КодВозврата = 0;
	ТекстОшибки = "";
	НакопленныеСообщения = Новый Массив;
	ИспользоватьЗавершениеРаботы = Ложь;

	Попытка
		ПутьКОбработке = ПолучитьПутьОбработки();

		ПараметрыКоманднойСтроки = ПолучитьСтруктуруПараметров(СтрокаЗапуска);
		ПреобразоватьПараметрыКоторыеНачинаютсяСТочкиКНормальнымПутям(ПараметрыКоманднойСтроки);

		Если ПараметрыКоманднойСтроки.Свойство("ФайлРезультата") Тогда
			ПутьФайлаРезультата = ПараметрыКоманднойСтроки.ФайлРезультата;
		КонецЕсли;

		Если ПараметрыКоманднойСтроки.Свойство("СоздатьАдминистратора") Или
				ПараметрыКоманднойСтроки.Свойство("AdminCreate") Тогда

			ИменаРолей = "";
			Если ПараметрыКоманднойСтроки.Свойство("Роли") Тогда
				ИменаРолей = ПараметрыКоманднойСтроки.Роли;
			КонецЕсли;

			СообщенияАдминистратора = СоздатьПервогоАдминистратораПриНеобходимости(
				ПараметрыКоманднойСтроки.Имя, ИменаРолей);
			Для Каждого Сообщение Из СообщенияАдминистратора Цикл
				НакопленныеСообщения.Добавить(Сообщение);
			КонецЦикла;
		КонецЕсли;

		Если ПараметрыКоманднойСтроки.Свойство("ЗавершитьРаботуСистемы") Тогда
			ИспользоватьЗавершениеРаботы = Истина;
		КонецЕсли;

	Исключение
		ТекстОшибки = ОписаниеОшибки();
		КодВозврата = 1;
	КонецПопытки;

	// Запись файла результата ДОЛЖНА выполниться при любом исходе и РАНЬШЕ
	// любого логирования: на только что созданной базе ЗаписьЖурналаРегистрации
	// может бросить исключение и прервать процедуру до записи результата.
	ЗаписатьФайлРезультата(ПутьФайлаРезультата, КодВозврата, ТекстОшибки, НакопленныеСообщения);

	Если КодВозврата <> 0 Тогда
		Лог("Неудача при обработке параметров запуска"
			+ Символы.ВК + "Параметры: " + СтрокаЗапуска
			+ Символы.ВК + ТекстОшибки);
	КонецЕсли;

	Если ИспользоватьЗавершениеРаботы Тогда
		ЗавершитьРаботуСистемы(Ложь, Ложь);
	Иначе
		ПрекратитьРаботуСистемы(Ложь);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Функция ПолучитьПутьОбработки()

	Перем ФайлПути, Результат;

	Результат = ПолучитьПутьКОбработкеСервер();
	Если НЕ ПустаяСтрока(ПутьКОбработке) Тогда
		ФайлПути = Новый Файл(ПутьКОбработке);
		Результат = ФайлПути.Путь;
	КонецЕсли;

	Возврат Результат;
КонецФункции

#КонецОбласти

