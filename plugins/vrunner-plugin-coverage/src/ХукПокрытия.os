// Хук сбора покрытия - вклинивается в запуск тестов блока test через прозвище "ХукЗапускаТестов".
//
// Вся оркестрация покрытия живёт ЗДЕСЬ (а не в подкомандах теста): перед запуском поднимает сеанс
// покрытия и дописывает аргументы отладки в параметры запуска; после запуска собирает и формирует
// отчёт; при ошибке - прерывает сеанс. Подкоманды теста об этом хуке не знают.
//
// Если покрытие не включено (--coverage-report не задан) - хук ничего не делает.

// BSLLS:MissingVariablesDescription-off Поля autumn (&Лог/&Пластилин).
&Лог("vrunner")
Перем Лог;

&Пластилин
Перем СервисПокрытия;

&Желудь
&Прозвище("ХукЗапускаТестов")
Процедура ПриСозданииОбъекта()
КонецПроцедуры

#Область ПрограммныйИнтерфейс

// Перед запуском тестов: если задан --coverage-report, поднять сеанс покрытия и дописать
// аргументы отладки (/Debug .../DEBUGGERURL) в ПараметрыЗапуска.ДополнительныеПараметры.
//
// Параметры:
//   Контекст - Структура - контекст запуска (ОпцииБлока, ПараметрыПодключения, ПараметрыПлатформы,
//              ПараметрыЗапуска [мутабельна])
//
Процедура ПередЗапуском(Контекст) Экспорт

	Опции = Контекст.ОпцииБлока;
	Если Опции = Неопределено ИЛИ НЕ Опции.Включено() Тогда
		Возврат;
	КонецЕсли;

	Если Контекст.ПараметрыЗапуска.Свойство("НеОжидать") И Контекст.ПараметрыЗапуска.НеОжидать = Истина Тогда
		ВызватьИсключение
			"Сбор покрытия (--coverage-report) несовместим с --no-wait: клиент 1С должен завершиться до сбора данных.";
	КонецЕсли;

	Сеанс = СервисПокрытия.НачатьСеанс(
		Опции.СформироватьПараметры(), Контекст.ПараметрыПодключения, Контекст.ПараметрыПлатформы);

	Контекст.ПараметрыЗапуска.ДополнительныеПараметры =
		СокрЛП(Контекст.ПараметрыЗапуска.ДополнительныеПараметры + " " + Сеанс.АргументыОтладки);
	// Для режима ibsrv: ibsrv подключится к этому же серверу отладки (серверный код в замерах).
	Контекст.ПараметрыЗапуска.Вставить("АдресСервераОтладки", Сеанс.АдресСервера);

	Контекст.Вставить("СеансПокрытия", Сеанс);

КонецПроцедуры

// После успешного запуска: собрать данные покрытия и сформировать отчёт.
//
// Параметры:
//   Контекст - Структура - контекст запуска
//
Процедура ПослеЗапуска(Контекст) Экспорт
	Если Контекст.Свойство("СеансПокрытия") Тогда
		СервисПокрытия.ЗавершитьСеанс(Контекст.СеансПокрытия);
	КонецЕсли;
КонецПроцедуры

// При ошибке запуска: прервать сеанс покрытия (без формирования отчёта).
//
// Параметры:
//   Контекст - Структура - контекст запуска
//
Процедура ПриОшибке(Контекст) Экспорт
	Если Контекст.Свойство("СеансПокрытия") Тогда
		СервисПокрытия.ПрерватьСеанс(Контекст.СеансПокрытия);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти
