// Встроенный плагин vrunner: сбор покрытия тестов (cross-cutting).
// Регистрирует набор опций --coverage-* (попадает во все команды блока test через слот-имя
// НаборОпцийПокрытия) и сервис-оркестратор СервисПокрытия. Generic-инфра (сервер отладки,
// покрываемые строки, поиск источников) остаётся в ядре vrunner и инжектится сюда.

Описание.Имя("vrunner-plugin-coverage")
		.Версия("0.1.0")
		.ВерсияСреды("2.0.0")
		.Описание("Сбор покрытия тестов: опции --coverage-* для команд блока test + оркестрация coveragebsl -> coverage.")

		.ЗависитОт("vanessa-runner")
		.ЗависитОт("coverage")
		.ЗависитОт("coveragebsl")
		.ЗависитОт("tempfiles")

		.ВключитьФайл("НаборОпцийПокрытия.os")
		.ВключитьФайл("src")
		.ВключитьФайл("package-loader.os")
		.ВключитьФайл("packagedef")
