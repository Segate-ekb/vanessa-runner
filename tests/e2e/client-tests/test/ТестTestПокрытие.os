// BSLLS-off
// Тестовый набор: сбор покрытия тестов (--coverage-report) для команд test.
//
// Лёгкие тесты (справка, валидация --no-wait) НЕ требуют платформы 1С.
// Полноценный сбор покрытия (тег integration) требует платформу 1С, компоненту coveragebsl
// и сервер отладки dbgs: поднимает файловую ИБ с движком YAxUnit и тестовым расширением,
// прогоняет тесты с покрытием и проверяет сформированный genericCoverage-отчёт.
//
// Фикстуры: tests/e2e/fixtures/yaxunit/ (YAxUnit.cfe + tests-ext, имя расширения "test").

#Использовать asserts
#Использовать tempfiles
#Использовать 1commands
#Использовать "../../utils"

Перем НакопленныеВременныеФайлы;

#Область СлужебныйПрограммныйИнтерфейс

// Справка yaxunit содержит все опции покрытия.
&Тест
Процедура ТестДолжен_ВывестиОпцииПокрытияВСправке() Экспорт

	Исполнитель = СоздатьИсполнителя("yaxunit");
	Исполнитель.ДобавитьФлаг("--help");

	Исполнитель.ВыполнитьКоманду();

	Исполнитель.ОжидаемЧтоКодВозврата(0, "справка test yaxunit --help");
	Исполнитель.ОжидаемЧтоВыводСодержит("--coverage-report");
	Исполнитель.ОжидаемЧтоВыводСодержит("--coverage-format");
	Исполнитель.ОжидаемЧтоВыводСодержит("--coverage-src");
	Исполнитель.ОжидаемЧтоВыводСодержит("--coverage-ext");
	Исполнитель.ОжидаемЧтоВыводСодержит("--coverage-server");

КонецПроцедуры

// Опции покрытия доступны и в xunit, и в vanessa.
&Тест
Процедура ТестДолжен_ВывестиОпцииПокрытияДляXunitИVanessa() Экспорт

	ИсполнительXunit = СоздатьИсполнителя("xunit");
	ИсполнительXunit.ДобавитьФлаг("--help");
	ИсполнительXunit.ВыполнитьКоманду();
	ИсполнительXunit.ОжидаемЧтоКодВозврата(0, "справка test xunit --help");
	ИсполнительXunit.ОжидаемЧтоВыводСодержит("--coverage-report");

	ИсполнительVanessa = СоздатьИсполнителя("vanessa");
	ИсполнительVanessa.ДобавитьФлаг("--help");
	ИсполнительVanessa.ВыполнитьКоманду();
	ИсполнительVanessa.ОжидаемЧтоКодВозврата(0, "справка test vanessa --help");
	ИсполнительVanessa.ОжидаемЧтоВыводСодержит("--coverage-report");

КонецПроцедуры

// Покрытие несовместимо с --no-wait: команда падает с понятной ошибкой (без запуска платформы).
&Тест
Процедура ТестДолжен_ОтклонитьПокрытиеСNoWait() Экспорт

	Исполнитель = СоздатьИсполнителя("yaxunit");
	Исполнитель.ДобавитьОпцию("--ibconnection", "/F""" + ВременныеФайлы.СоздатьКаталог() + """");
	Исполнитель.ДобавитьОпцию("--coverage-report", ОбъединитьПути(Исполнитель.КаталогРаботы(), "gc.xml"));
	Исполнитель.ДобавитьФлаг("--no-wait");

	Исполнитель.ВыполнитьКоманду();

	КодВозврата = Исполнитель.КодВозврата();
	Ожидаем.Что(КодВозврата, "ненулевой код при покрытии с --no-wait").Не_().Равно(0);
	Исполнитель.ОжидаемЧтоВыводСодержит("no-wait");

КонецПроцедуры

// Полный сбор покрытия YAxUnit: тест исполняется, покрытие расширения попадает в genericCoverage-отчёт.
&Тест
&Тег("integration")
Процедура ТестДолжен_СобратьПокрытиеYAxUnit() Экспорт

	// Дано - ИБ с движком YAxUnit и тестовым расширением "test"
	КаталогБазы = ФикстурнаяФайловаяБД.СкопироватьВоВременнойКаталог();
	СтрокаПодключения = "/F""" + КаталогБазы + """";

	ЗагрузитьРасширение(СтрокаПодключения, "YAxUnit", ПутьФикстуры("YAxUnit.cfe"));
	ЗагрузитьРасширение(СтрокаПодключения, "test", ПутьФикстуры("tests-ext"));

	Прогон = СоздатьИсполнителя("yaxunit");
	ПутьОтчёта = ОбъединитьПути(Прогон.КаталогРаботы(), "coverage", "genericCoverage.xml");
	Прогон.ДобавитьОпцию("--ibconnection", СтрокаПодключения);
	Прогон.ДобавитьОпцию("--ext", "test");
	Прогон.ДобавитьОпцию("--coverage-report", ПутьОтчёта);
	Прогон.ДобавитьОпцию("--coverage-ext", ПутьФикстуры("tests-ext"));

	// Когда
	Прогон.ВыполнитьКоманду();

	// Тогда - команда успешна, отчёт сформирован и содержит покрытый модуль расширения
	Прогон.ОжидаемЧтоКодВозврата(0, "прогон YAxUnit со сбором покрытия");
	Прогон.ОжидаемЧтоВыводСодержит("Включён сбор покрытия");
	Прогон.ОжидаемЧтоВыводСодержит("Отчёт покрытия сформирован");
	Прогон.ОжидаемЧтоФайлСуществует("coverage/genericCoverage.xml");

	Отчёт = ПрочитатьФайл(ПутьОтчёта);
	Ожидаем.Что(Отчёт, "genericCoverage XML").Содержит("<coverage");
	Ожидаем.Что(Отчёт, "покрыт модуль тестового расширения").Содержит("Ext1_ПервыйТест");

КонецПроцедуры

// Формат отчёта переопределяется через --coverage-format (cobertura).
&Тест
&Тег("integration")
Процедура ТестДолжен_СформироватьОтчётCobertura() Экспорт

	// Дано
	КаталогБазы = ФикстурнаяФайловаяБД.СкопироватьВоВременнойКаталог();
	СтрокаПодключения = "/F""" + КаталогБазы + """";

	ЗагрузитьРасширение(СтрокаПодключения, "YAxUnit", ПутьФикстуры("YAxUnit.cfe"));
	ЗагрузитьРасширение(СтрокаПодключения, "test", ПутьФикстуры("tests-ext"));

	Прогон = СоздатьИсполнителя("yaxunit");
	ПутьОтчёта = ОбъединитьПути(Прогон.КаталогРаботы(), "coverage", "cobertura.xml");
	Прогон.ДобавитьОпцию("--ibconnection", СтрокаПодключения);
	Прогон.ДобавитьОпцию("--ext", "test");
	Прогон.ДобавитьОпцию("--coverage-report", ПутьОтчёта);
	Прогон.ДобавитьОпцию("--coverage-format", "cobertura");
	Прогон.ДобавитьОпцию("--coverage-ext", ПутьФикстуры("tests-ext"));

	// Когда
	Прогон.ВыполнитьКоманду();

	// Тогда
	Прогон.ОжидаемЧтоКодВозврата(0, "прогон YAxUnit с отчётом Cobertura");
	Прогон.ОжидаемЧтоФайлСуществует("coverage/cobertura.xml");
	Отчёт = ПрочитатьФайл(ПутьОтчёта);
	Ожидаем.Что(Отчёт, "Cobertura XML").Содержит("coverage");

КонецПроцедуры

// Сбор покрытия через автономный сервер (ibsrv): серверный код исполняется в процессе ibsrv,
// который подключается к нашему серверу отладки - покрытие модуля расширения попадает в отчёт.
&Тест
&Тег("integration")
Процедура ТестДолжен_СобратьПокрытиеЧерезIbsrv() Экспорт

	// Дано
	КаталогБазы = ФикстурнаяФайловаяБД.СкопироватьВоВременнойКаталог();
	СтрокаПодключения = "/F""" + КаталогБазы + """";

	ЗагрузитьРасширение(СтрокаПодключения, "YAxUnit", ПутьФикстуры("YAxUnit.cfe"));
	ЗагрузитьРасширение(СтрокаПодключения, "test", ПутьФикстуры("tests-ext"));

	Прогон = СоздатьИсполнителя("yaxunit");
	ПутьОтчёта = ОбъединитьПути(Прогон.КаталогРаботы(), "coverage", "genericCoverage.xml");
	Прогон.ДобавитьОпцию("--ibconnection", СтрокаПодключения);
	Прогон.ДобавитьОпцию("--ext", "test");
	Прогон.ДобавитьОпцию("--coverage-report", ПутьОтчёта);
	Прогон.ДобавитьОпцию("--coverage-ext", ПутьФикстуры("tests-ext"));
	Прогон.ДобавитьФлаг("--ibsrv");

	// Когда
	Прогон.ВыполнитьКоманду();

	// Тогда - покрытие серверного кода ibsrv попало в отчёт
	Прогон.ОжидаемЧтоКодВозврата(0, "прогон YAxUnit со сбором покрытия через ibsrv");
	Прогон.ОжидаемЧтоВыводСодержит("Отчёт покрытия сформирован");
	Прогон.ОжидаемЧтоФайлСуществует("coverage/genericCoverage.xml");

	Отчёт = ПрочитатьФайл(ПутьОтчёта);
	Ожидаем.Что(Отчёт, "покрыт модуль тестового расширения (ibsrv)").Содержит("Ext1_ПервыйТест");

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт
	НакопленныеВременныеФайлы = ВременныеФайлы.Файлы();
КонецПроцедуры

&ПослеКаждого
Процедура ПослеЗапускаТеста() Экспорт
	ВременныеФайлы.УдалитьНакопленныеВременныеФайлы(НакопленныеВременныеФайлы);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьИсполнителя(Знач Подкоманда)
	Аргументы = Новый Массив;
	Аргументы.Добавить("test");
	Аргументы.Добавить(Подкоманда);
	Возврат Новый ИсполнительCLI(Аргументы);
КонецФункции

Функция ПутьФикстуры(Знач ИмяФайла)
	Возврат СоздатьИсполнителя("yaxunit").ПутьФикстуры("yaxunit", ИмяФайла);
КонецФункции

Процедура ЗагрузитьРасширение(Знач СтрокаПодключения, Знач ИмяРасширения, Знач ПутьИсточника)
	Аргументы = Новый Массив;
	Аргументы.Добавить("cfe");
	Аргументы.Добавить("load");
	Загрузчик = Новый ИсполнительCLI(Аргументы);
	Загрузчик.ДобавитьОпцию("--ibconnection", СтрокаПодключения);
	Загрузчик.ДобавитьОпцию("--extension-name", ИмяРасширения);
	Загрузчик.ДобавитьФлаг("--update-db");
	Загрузчик.ДобавитьАргумент(ПутьИсточника);
	Загрузчик.ВыполнитьКоманду();
	Загрузчик.ОжидаемЧтоКодВозврата(0, "загрузка расширения " + ИмяРасширения);
КонецПроцедуры

Функция ПрочитатьФайл(Знач Путь)
	Чтение = Новый ЧтениеТекста(Путь, "UTF-8");
	Содержимое = Чтение.Прочитать();
	Чтение.Закрыть();
	Возврат Содержимое;
КонецФункции

#КонецОбласти
