// Помощник для управления общей файловой ИБ в интеграционных тестах.
//
// Создаёт файловую ИБ из 1cv8.cf один раз на процесс;
// каждый следующий вызов ПолучитьИзолированнуюИБ() возвращает
// изолированную копию — без ibcmd, без конкуренции за кэш платформы.

#Использовать asserts
#Использовать tempfiles
#Использовать 1commands

Перем _ОбщаяИБ;

#Область ПрограммныйИнтерфейс

// Вернуть изолированную копию файловой ИБ, инициализированной из 1cv8.cf.
// ИБ создаётся через ibcmd один раз; повторные вызовы копируют готовую базу.
//
// Возвращаемое значение:
//   Строка - путь к каталогу изолированной копии ИБ
//
Функция ПолучитьИзолированнуюИБ() Экспорт
	Если _ОбщаяИБ = Неопределено Тогда
		_ОбщаяИБ = ОбъединитьПути(ВременныеФайлы.СоздатьКаталог(), "ib");
		СоздатьИБ(_ОбщаяИБ);
	КонецЕсли;
	Возврат СкопироватьИБ(_ОбщаяИБ);
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура СоздатьИБ(КаталогБазы)
	Аргументы = Новый Массив;
	Аргументы.Добавить("infobase");
	Аргументы.Добавить("init");
	Исполнитель = Новый ИсполнительCLI(Аргументы);

	Исполнитель.ДобавитьОпцию("--ibconnection", "/F""" + КаталогБазы + """");
	Исполнитель.ДобавитьОпцию("--source", Исполнитель.ПутьФикстуры("1cv8.cf"));
	Исполнитель.ДобавитьФлаг("--ibcmd");
	Исполнитель.ВыполнитьКоманду();
	Исполнитель.ОжидаемЧтоКодВозврата(0, "создание общей ИБ");
КонецПроцедуры

Функция СкопироватьИБ(ОбщаяИБ)
	КаталогКопии = ВременныеФайлы.СоздатьКаталог();
	КопироватьФайлы(ОбщаяИБ, КаталогКопии);
	Возврат ОбъединитьПути(КаталогКопии, "ib");
КонецФункции

#КонецОбласти
