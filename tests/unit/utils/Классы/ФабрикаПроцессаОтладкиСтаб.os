// BSLLS:ExportVariables-off
// BSLLS:MissingVariablesDescription-off
// BSLLS:LatinAndCyrillicSymbolInWord-off
// Стаб фабрики процесса сервера отладки для юнит-тестов СервисСервераОтладки.
// Реализует контракт _ФабрикаПроцесса.Запустить(СтрокаЗапуска, ПутьОповещения) -> Процесс:
// запоминает строку запуска, при необходимости создаёт файл оповещения (имитация готовности
// dbgs) и возвращает фейковый процесс (ПроцессПлатформыСтаб) с методом Завершить().

Перем ПоследняяСтрокаЗапуска Экспорт;
Перем КоличествоЗапусков Экспорт;
Перем СозданныйПроцесс Экспорт;
Перем СоздаватьФайлОповещения;

Процедура ПриСозданииОбъекта()
	ПоследняяСтрокаЗапуска = "";
	КоличествоЗапусков = 0;
	СозданныйПроцесс = Неопределено;
	СоздаватьФайлОповещения = Истина;
КонецПроцедуры

// Не создавать файл оповещения (имитация не стартовавшего сервера).
//
// Возвращаемое значение:
//   ФабрикаПроцессаОтладкиСтаб - этот объект
//
Функция БезФайлаОповещения() Экспорт
	СоздаватьФайлОповещения = Ложь;
	Возврат ЭтотОбъект;
КонецФункции

Функция Запустить(Знач СтрокаЗапуска, Знач ПутьОповещения) Экспорт

	ПоследняяСтрокаЗапуска = СтрокаЗапуска;
	КоличествоЗапусков = КоличествоЗапусков + 1;

	Если СоздаватьФайлОповещения Тогда
		Запись = Новый ЗаписьТекста(ПутьОповещения, КодировкаТекста.UTF8);
		Запись.ЗаписатьСтроку("ready");
		Запись.Закрыть();
	КонецЕсли;

	СозданныйПроцесс = Новый ПроцессПлатформыСтаб();
	Возврат СозданныйПроцесс;

КонецФункции
