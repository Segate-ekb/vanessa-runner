// Загрузка встроенных плагинов (блок команд test и др.) ДО создания контейнера autumn:
// классы плагинов регистрируются в системе типов, чтобы DI-скан autumn их подхватил.
ЗагрузчикПлагинов = Новый ЗагрузчикПлагинов("vanessa-runner");
КаталогПлагинов = ОбъединитьПути(ТекущийСценарий().Каталог, "..", "plugins");
ЗагрузчикПлагинов.КаталогПлагинов(КаталогПлагинов).Загрузить();

Настройка = Новый НастройкаПриложения(АргументыКоманднойСтроки);

Поделка = Новый Поделка(Настройка.Совет());
Поделка.ЗапуститьПриложение();
